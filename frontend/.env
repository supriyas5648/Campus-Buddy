# Base URL for the CampusBuddy API.
# Leave as "/api" in development — vite.config.js proxies it to localhost:5000.
# In production set it to the full URL, e.g. https://api.campusbuddy.edu/api
VITE_API_BASE_URL=/api

# Path (relative to the public folder) of the campus map SVG.
VITE_CAMPUS_MAP_URL=/campus_map.svg

# viewBox of that SVG — node coordinates from the API are in this space.
VITE_MAP_WIDTH=2483
VITE_MAP_HEIGHT=1621
