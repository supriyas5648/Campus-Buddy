# ---------------------------------------------------------------------------
# CampusBuddy backend configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/campusbuddy
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/campusbuddy?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campusbuddy

# Comma separated list of origins allowed to call the API (the Vite dev server)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
